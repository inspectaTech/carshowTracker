# Claude Code config — routes through DeepSeek API instead of Anthropic
# Allows using DeepSeek models (v4-pro, v4-flash) with Claude Code CLI
# Set by: export ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# Auth: DeepSeek API key (sk-...)
#
# Note: Pencil MCP may not support write operations through this proxy.
# See notes/pencil-workflow.md for details.

export ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
export ANTHROPIC_AUTH_TOKEN=sk-5381376418104bdd9e12211233a3464f
export ANTHROPIC_MODEL=deepseek-v4-pro[1m]
export ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-v4-pro[1m]
export ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-v4-pro[1m]
export ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-v4-flash
export CLAUDE_CODE_SUBAGENT_MODEL=deepseek-v4-flash
export CLAUDE_CODE_EFFORT_LEVEL=max

